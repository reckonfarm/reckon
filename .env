# Committed feature-flag defaults — the ONLY thing that belongs in this file.
# NEVER put secrets here; secrets live in .env.local (local) / Vercel env (deploys),
# both gitignored. Next.js precedence: Vercel dashboard env > .env.local > this file —
# so a Vercel env var can flip any flag without a code change (see lib/flags.ts).
